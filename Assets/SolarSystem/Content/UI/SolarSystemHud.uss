.hud-root {
    position: absolute;
    top: 32px;
    left: 32px;
    right: 32px;
    bottom: 32px;
}

.status-panel {
    position: absolute;
    top: 0;
    left: 0;
    width: 420px;
    padding: 20px 22px 18px 22px;
    background-color: rgba(6, 13, 25, 0.88);
    border-left-width: 3px;
    border-left-color: rgb(77, 193, 225);
    border-top-left-radius: 3px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 12px;
}

.eyebrow {
    margin-bottom: 9px;
    color: rgb(111, 210, 235);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.target {
    color: rgb(243, 247, 251);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.divider {
    height: 1px;
    margin-top: 14px;
    margin-bottom: 13px;
    background-color: rgba(150, 180, 205, 0.25);
}

.status {
    margin-bottom: 7px;
    color: rgb(117, 224, 178);
    font-size: 13px;
    -unity-font-style: bold;
}

.status.is-paused {
    color: rgb(255, 190, 104);
}

.rate {
    color: rgb(190, 204, 218);
    font-size: 12px;
}

.scale-mode {
    margin-top: 7px;
    color: rgb(111, 210, 235);
    font-size: 10px;
    -unity-font-style: bold;
    white-space: normal;
}

.labels-state {
    margin-top: 5px;
    color: rgb(152, 176, 195);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.7px;
}

.menu-launcher {
    position: absolute;
    top: 0;
    right: 410px;
    height: 36px;
    padding-left: 16px;
    padding-right: 16px;
    color: rgb(211, 230, 241);
    background-color: rgba(6, 13, 25, 0.9);
    border-color: rgba(111, 210, 235, 0.62);
    border-radius: 6px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.menu-launcher:hover,
.menu-launcher:focus {
    color: rgb(255, 255, 255);
    background-color: rgb(17, 54, 74);
    border-color: rgb(91, 220, 246);
}

.world-label-layer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.world-label {
    position: absolute;
    width: 118px;
    height: 28px;
    padding: 5px 8px;
    color: rgb(214, 229, 239);
    background-color: rgba(4, 10, 19, 0.78);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-color: rgba(111, 210, 235, 0.42);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 0.7px;
}

.world-label.is-selected {
    color: rgb(243, 247, 251);
    background-color: rgba(16, 64, 78, 0.92);
    border-color: rgb(91, 220, 246);
    border-left-width: 3px;
}

.navigator-panel {
    position: absolute;
    top: 250px;
    left: 0;
    bottom: 150px;
    width: 420px;
    padding: 17px 16px 15px 16px;
    background-color: rgba(6, 13, 25, 0.96);
    border-left-width: 3px;
    border-left-color: rgb(77, 193, 225);
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
}

.navigator-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.navigator-eyebrow {
    margin-bottom: 4px;
}

.navigator-title {
    color: rgb(243, 247, 251);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.navigator-close-hint {
    align-items: center;
}

.navigator-close-action {
    margin-top: 3px;
    color: rgb(183, 201, 217);
    font-size: 8px;
    -unity-font-style: bold;
}

.navigator-keyboard-hint {
    margin-top: 12px;
    margin-bottom: 10px;
    color: rgb(133, 157, 178);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
}

.navigator-list {
    flex-grow: 1;
}

.navigator-row {
    min-height: 43px;
    margin-bottom: 5px;
    padding: 7px 10px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    color: rgb(222, 234, 243);
    background-color: rgba(16, 28, 44, 0.72);
    border-left-width: 2px;
    border-left-color: rgba(111, 210, 235, 0.42);
    border-top-left-radius: 4px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 7px;
}

.navigator-row:hover,
.navigator-row:focus {
    background-color: rgba(24, 57, 74, 0.92);
    border-left-color: rgb(91, 220, 246);
}

.navigator-row.is-selected {
    background-color: rgba(18, 67, 82, 0.94);
    border-left-width: 4px;
    border-left-color: rgb(91, 220, 246);
}

.navigator-row.is-moon {
    margin-left: 24px;
    min-height: 38px;
    background-color: rgba(12, 22, 36, 0.72);
}

.navigator-row-name {
    color: rgb(235, 243, 249);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
}

.navigator-row-type {
    color: rgb(111, 210, 235);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.navigator-row.is-moon .navigator-row-type {
    color: rgb(157, 177, 195);
}

.hint-panel {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 12px 14px 13px 14px;
    background-color: rgba(6, 13, 25, 0.9);
    border-left-width: 2px;
    border-left-color: rgba(111, 210, 235, 0.7);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.hint-title {
    margin-bottom: 8px;
    color: rgb(133, 157, 178);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1.3px;
}

.control-hints {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.control-group {
    min-width: 56px;
    margin-right: 12px;
    align-items: center;
}

.control-group-wide {
    min-width: 66px;
}

.control-group-last {
    margin-right: 0;
}

.control-key {
    min-width: 38px;
    height: 25px;
    padding: 4px 9px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 0.5px;
}

.control-action {
    margin-top: 5px;
    color: rgb(183, 201, 217);
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 0.7px;
}

.key-click {
    color: rgb(109, 226, 250);
    background-color: rgba(21, 88, 107, 0.62);
    border-color: rgb(76, 189, 218);
}

.key-focus {
    color: rgb(198, 165, 255);
    background-color: rgba(72, 48, 112, 0.65);
    border-color: rgb(145, 105, 211);
}

.key-wheel {
    color: rgb(135, 235, 181);
    background-color: rgba(31, 91, 63, 0.65);
    border-color: rgb(80, 176, 123);
}

.key-space {
    color: rgb(255, 205, 125);
    background-color: rgba(105, 70, 28, 0.68);
    border-color: rgb(207, 143, 61);
}

.key-speed {
    color: rgb(255, 151, 181);
    background-color: rgba(105, 40, 63, 0.68);
    border-color: rgb(202, 83, 123);
}

.key-compare {
    color: rgb(116, 222, 239);
    background-color: rgba(19, 78, 94, 0.68);
    border-color: rgb(63, 173, 196);
}

.key-navigator {
    color: rgb(118, 220, 255);
    background-color: rgba(22, 75, 105, 0.68);
    border-color: rgb(69, 164, 207);
}

.key-labels {
    color: rgb(232, 196, 255);
    background-color: rgba(78, 48, 100, 0.68);
    border-color: rgb(158, 103, 194);
}

.key-orbits {
    color: rgb(122, 231, 205);
    background-color: rgba(25, 85, 76, 0.68);
    border-color: rgb(66, 176, 151);
}

.key-motion {
    color: rgb(255, 219, 107);
    background-color: rgba(76, 60, 17, 0.78);
    border-color: rgb(224, 180, 45);
}

.key-help {
    color: rgb(188, 216, 255);
    background-color: rgba(43, 65, 101, 0.72);
    border-color: rgb(99, 143, 203);
}

.key-exit {
    color: rgb(207, 219, 229);
    background-color: rgba(55, 66, 82, 0.72);
    border-color: rgb(116, 136, 158);
}

.body-information-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: 390px;
    padding: 20px 22px 18px 22px;
    background-color: rgba(6, 13, 25, 0.92);
    border-right-width: 3px;
    border-right-color: rgb(77, 193, 225);
    border-top-left-radius: 12px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 3px;
}

.body-name {
    color: rgb(243, 247, 251);
    font-size: 30px;
    -unity-font-style: bold;
}

.body-category {
    margin-top: 2px;
    color: rgb(111, 210, 235);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
}

.body-summary {
    margin-top: 12px;
    color: rgb(207, 219, 229);
    font-size: 13px;
    white-space: normal;
}

.fact-row {
    min-height: 26px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.fact-key {
    color: rgb(133, 157, 178);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
}

.fact-value {
    max-width: 205px;
    color: rgb(235, 241, 246);
    font-size: 12px;
    -unity-text-align: middle-right;
    white-space: normal;
}

.scale-note {
    margin-top: 12px;
    padding: 9px 10px;
    color: rgb(255, 198, 116);
    background-color: rgba(92, 59, 23, 0.45);
    font-size: 9px;
    -unity-font-style: bold;
    white-space: normal;
}

.source-key {
    margin-top: 11px;
    color: rgb(133, 157, 178);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.7px;
}

.source-value {
    margin-top: 3px;
    color: rgb(159, 181, 199);
    font-size: 9px;
    white-space: normal;
}

.selection-reticle {
    position: absolute;
}

.scale-comparison-panel {
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: 0;
    min-height: 190px;
    padding: 20px 24px 18px 24px;
    background-color: rgba(6, 13, 25, 0.95);
    border-top-width: 2px;
    border-top-color: rgb(77, 193, 225);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.comparison-progress {
    color: rgb(111, 210, 235);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1.4px;
}

.comparison-title {
    margin-top: 7px;
    color: rgb(243, 247, 251);
    font-size: 24px;
    -unity-font-style: bold;
}

.comparison-metric {
    margin-top: 8px;
    color: rgb(255, 198, 116);
    font-size: 11px;
    -unity-font-style: bold;
    white-space: normal;
}

.comparison-description {
    margin-top: 8px;
    margin-right: 150px;
    color: rgb(207, 219, 229);
    font-size: 12px;
    white-space: normal;
}

.comparison-controls {
    position: absolute;
    right: 22px;
    bottom: 18px;
    flex-direction: row;
}

.comparison-control-group {
    min-width: 58px;
    margin-left: 12px;
    align-items: center;
}

.comparison-control-action {
    margin-top: 4px;
    color: rgb(183, 201, 217);
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-root.comparison-active .body-information-panel,
.hud-root.comparison-active .hint-panel,
.hud-root.comparison-active .navigator-panel,
.hud-root.comparison-active .world-label-layer {
    display: none;
}

.reticle-corner {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: rgb(91, 220, 246);
}

.reticle-top-left {
    top: 0;
    left: 0;
    border-top-width: 2px;
    border-left-width: 2px;
}

.reticle-top-right {
    top: 0;
    right: 0;
    border-top-width: 2px;
    border-right-width: 2px;
}

.reticle-bottom-left {
    bottom: 0;
    left: 0;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.reticle-bottom-right {
    right: 0;
    bottom: 0;
    border-right-width: 2px;
    border-bottom-width: 2px;
}

.menu-overlay {
    position: absolute;
    top: -32px;
    left: -32px;
    right: -32px;
    bottom: -32px;
    padding: 40px 12%;
    background-color: rgba(0, 3, 9, 0.84);
}

.menu-panel {
    flex-grow: 1;
    min-height: 0;
    padding: 22px 26px 24px 26px;
    background-color: rgb(6, 13, 25);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 3px;
    border-color: rgba(111, 210, 235, 0.62);
    border-left-color: rgb(77, 193, 225);
    border-radius: 12px;
}

.menu-header {
    min-height: 64px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.menu-title {
    color: rgb(243, 247, 251);
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.menu-close-button {
    height: 34px;
    padding-left: 14px;
    padding-right: 14px;
    color: rgb(225, 235, 243);
    background-color: rgb(37, 45, 58);
    border-color: rgb(103, 125, 148);
    border-radius: 5px;
    font-size: 10px;
    -unity-font-style: bold;
}

.menu-close-button:hover,
.menu-close-button:focus {
    background-color: rgb(57, 68, 84);
    border-color: rgb(157, 184, 208);
}

.menu-tabs {
    height: 42px;
    margin-top: 8px;
    margin-bottom: 14px;
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: rgba(150, 180, 205, 0.25);
}

.menu-tab {
    min-width: 126px;
    height: 36px;
    margin-right: 8px;
    padding-left: 16px;
    padding-right: 16px;
    color: rgb(157, 180, 199);
    background-color: rgba(16, 28, 44, 0.72);
    border-color: rgba(111, 210, 235, 0.25);
    border-radius: 5px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.menu-tab:hover,
.menu-tab:focus,
.menu-tab.is-active {
    color: rgb(243, 247, 251);
    background-color: rgb(18, 67, 82);
    border-color: rgb(91, 220, 246);
}

.menu-page {
    flex-grow: 1;
    min-height: 0;
    padding: 4px 10px 12px 4px;
}

.onboarding-label {
    margin-bottom: 16px;
    padding: 9px 12px;
    color: rgb(255, 213, 135);
    background-color: rgba(92, 59, 23, 0.45);
    border-left-width: 3px;
    border-left-color: rgb(223, 160, 67);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.menu-section-title {
    margin-top: 8px;
    margin-bottom: 8px;
    color: rgb(111, 210, 235);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.4px;
}

.menu-copy {
    margin-bottom: 12px;
    color: rgb(211, 224, 236);
    font-size: 13px;
    white-space: normal;
}

.menu-note {
    margin-top: 10px;
    margin-bottom: 10px;
    padding: 10px 12px;
    color: rgb(172, 194, 211);
    background-color: rgba(16, 28, 44, 0.72);
    border-left-width: 2px;
    border-left-color: rgba(111, 210, 235, 0.55);
    font-size: 11px;
    white-space: normal;
}

.help-grid {
    margin-top: 10px;
    margin-bottom: 12px;
    flex-direction: row;
}

.help-column {
    width: 50%;
    margin-right: 22px;
    padding: 12px 14px;
    background-color: rgba(16, 28, 44, 0.58);
    border-radius: 6px;
}

.help-controls {
    color: rgb(225, 235, 243);
}

.setting-row {
    min-height: 42px;
    margin-bottom: 4px;
    flex-direction: row;
    align-items: center;
}

.setting-label {
    width: 190px;
    color: rgb(211, 224, 236);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.7px;
}

.setting-slider {
    flex-grow: 1;
    min-width: 240px;
}

.setting-value {
    width: 58px;
    margin-left: 12px;
    color: rgb(111, 210, 235);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.setting-toggle {
    min-height: 32px;
    margin-top: 5px;
    color: rgb(222, 234, 243);
    font-size: 11px;
    -unity-font-style: bold;
}

.settings-section,
.credits-section {
    margin-top: 22px;
}

.restore-defaults-button {
    width: 230px;
    height: 36px;
    margin-top: 16px;
    color: rgb(255, 218, 161);
    background-color: rgb(70, 47, 22);
    border-color: rgb(190, 126, 48);
    border-radius: 5px;
    font-size: 10px;
    -unity-font-style: bold;
}

.restore-defaults-button:hover,
.restore-defaults-button:focus {
    background-color: rgb(94, 63, 28);
    border-color: rgb(235, 166, 78);
}

.hud-root.menu-active .status-panel,
.hud-root.menu-active .body-information-panel,
.hud-root.menu-active .selection-reticle,
.hud-root.menu-active .navigator-panel,
.hud-root.menu-active .world-label-layer,
.hud-root.menu-active .hint-panel,
.hud-root.menu-active .scale-comparison-panel,
.hud-root.menu-active .cinematic-tour-panel,
.hud-root.menu-active .menu-launcher {
    display: none;
}

.is-hidden {
    display: none;
}

.cinematic-tour-panel {
    position: absolute;
    left: 32px;
    bottom: 32px;
    width: 480px;
    padding: 22px 24px;
    background-color: rgba(3, 13, 25, 0.94);
    border-left-width: 3px;
    border-left-color: rgb(50, 211, 238);
    border-radius: 8px;
}

.tour-progress {
    color: rgb(73, 210, 235);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.tour-title {
    margin-top: 8px;
    color: rgb(240, 247, 255);
    font-size: 28px;
    -unity-font-style: bold;
}

.tour-subtitle {
    margin-top: 3px;
    color: rgb(140, 161, 185);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.tour-description {
    margin-top: 12px;
    color: rgb(211, 224, 238);
    font-size: 14px;
    white-space: normal;
}

.tour-controls {
    margin-top: 16px;
    flex-direction: row;
}

.tour-button {
    height: 34px;
    margin-right: 10px;
    padding-left: 15px;
    padding-right: 15px;
    color: rgb(232, 245, 255);
    background-color: rgb(17, 54, 74);
    border-color: rgb(50, 211, 238);
    border-radius: 5px;
    -unity-font-style: bold;
}

.tour-exit-button {
    color: rgb(238, 205, 213);
    background-color: rgb(62, 30, 43);
    border-color: rgb(177, 76, 111);
}

.tour-motion-button {
    color: rgb(255, 228, 151);
    background-color: rgb(61, 49, 21);
    border-color: rgb(211, 164, 54);
}

.key-tour {
    color: rgb(255, 219, 107);
    background-color: rgb(76, 60, 17);
    border-color: rgb(224, 180, 45);
}

.tour-active .hint-panel,
.tour-active .status-panel,
.tour-active .body-information-panel,
.tour-active .selection-reticle,
.tour-active .navigator-panel {
    display: none;
}

.is-compact .cinematic-tour-panel {
    left: 18px;
    right: 18px;
    bottom: 18px;
    width: auto;
    padding: 15px 17px;
}

.is-compact .tour-controls {
    flex-wrap: wrap;
}

.is-compact .tour-button {
    margin-bottom: 8px;
}

.is-compact .tour-title {
    font-size: 21px;
}

.is-compact .tour-description {
    font-size: 12px;
}

.hud-root.is-compact .status-panel {
    width: 360px;
    padding: 16px 18px 15px 18px;
}

.hud-root.is-compact .menu-launcher {
    right: 360px;
}

.hud-root.is-compact .menu-overlay {
    padding: 18px;
}

.hud-root.is-compact .menu-panel {
    padding: 16px 18px 18px 18px;
}

.hud-root.is-compact .menu-title {
    font-size: 22px;
}

.hud-root.is-compact .menu-tab {
    min-width: 98px;
    padding-left: 10px;
